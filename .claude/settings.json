{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=/opt/meshforge/src python3 -m mini_dudeai.warmstart --hook 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/lint.py --severity warning \"$CLAUDE_TOOL_ARG_file_path\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "case \"$CLAUDE_TOOL_ARG_file_path\" in */.claude/settings.json|.claude/settings.json) python3 scripts/validate_claude_settings.py \"$CLAUDE_TOOL_ARG_file_path\" ;; esac"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(ls:*)",
      "Bash(cd:*)",
      "Bash(wc:*)",
      "Bash(pwd)",
      "Bash(python3 -m pytest:*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(python3 scripts/lint.py:*)",
      "Bash(python3 scripts/validate_claude_settings.py:*)",
      "Bash(python3 src/*)",
      "Bash(pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push origin:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(sudo systemctl start meshtasticd)",
      "Bash(sudo systemctl stop meshtasticd)",
      "Bash(sudo systemctl restart meshtasticd)",
      "Bash(sudo systemctl start rnsd)",
      "Bash(sudo systemctl stop rnsd)",
      "Bash(sudo systemctl restart rnsd)",
      "Bash(sudo systemctl start hamclock)",
      "Bash(sudo systemctl stop hamclock)",
      "Bash(sudo systemctl restart hamclock)",
      "Bash(sudo systemctl start mosquitto)",
      "Bash(sudo systemctl stop mosquitto)",
      "Bash(sudo systemctl restart mosquitto)",
      "Bash(sudo systemctl start meshforge-map)",
      "Bash(sudo systemctl stop meshforge-map)",
      "Bash(sudo systemctl restart meshforge-map)",
      "Bash(sudo journalctl:*)",
      "Bash(sudo -n git -C /opt/meshforge pull:*)",
      "Bash(systemctl is-active:*)",
      "Bash(systemctl status:*)",
      "Bash(journalctl:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo rm:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git config --global:*)",
      "Bash(sudo pip install:*)",
      "Bash(sudo pip3 install:*)",
      "Bash(sudo chmod 777:*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(python3 -c:*)",
      "Bash(python -c:*)",
      "Bash(bash -c:*)",
      "Bash(sh -c:*)",
      "Bash(zsh -c:*)",
      "Bash(eval:*)",
      "Bash(exec:*)",
      "Bash(source:*)",
      "Bash(. :*)"
    ]
  }
}
