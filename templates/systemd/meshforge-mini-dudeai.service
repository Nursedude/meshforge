[Unit]
Description=mini-dudeai — local rule runtime atop digest substrate (wireclaw.io-shaped)
After=network-online.target meshforge-digest.service
Wants=network-online.target

[Service]
Type=simple
# SDK-driven daemon. Reads rules + writes state in operator home; reads
# watchdog.json from /var/lib/meshforge; reads /api/status; posts to ntfy.
Environment=PYTHONPATH=/opt/meshforge/src
# Operator-specific values (ntfy topic, federator URL) live in this env file,
# NOT in the repo (MF014). Leading `-` makes it optional so first-boot doesn't
# fail before the file exists; the preset will fail loud if MINI_DUDEAI_NTFY_TOPIC
# is missing.
EnvironmentFile=-%h/.config/meshforge/mini_dudeai.env
ExecStart=/usr/bin/python3 -m mini_dudeai --preset meshforge_fleet --interval 30
Restart=on-failure
RestartSec=10
ProtectSystem=strict
ReadWritePaths=%h
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
