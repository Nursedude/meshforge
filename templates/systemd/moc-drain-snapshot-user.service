# MeshForge — moc/moc1 drain snapshot (systemd-user one-shot)
# ============================================================
#
# Pairs with moc-drain-snapshot-user.timer to emit one journal line per
# morning showing where moc and moc1's node_history.db drain stands.
# See project_moc_post_drain_vacuum.md for the underlying arc — DBs are
# at 4.7 GB draining at ~120K rows/hour, expected to converge
# 2026-05-14/15.
#
# Morning check: journalctl --user -u moc-drain-snapshot
#
# Install (run on the operator's "manager" box, typically the same box
# running nomadnet-silence-watch):
#   cp /opt/meshforge/templates/systemd/moc-drain-snapshot-user.service \
#      ~/.config/systemd/user/moc-drain-snapshot.service
#   cp /opt/meshforge/templates/systemd/moc-drain-snapshot-user.timer \
#      ~/.config/systemd/user/moc-drain-snapshot.timer
#   systemctl --user daemon-reload
#   systemctl --user enable --now moc-drain-snapshot.timer

[Unit]
Description=moc/moc1 node_history drain snapshot (one-shot)
# NOTE: network-online.target does not exist in the systemd USER manager, so
# an After= on it never delays anything. The timer's Persistent=true fires a
# catch-up at manager start (boot+~15s) — before DNS is up — so the ssh legs
# died on "Could not resolve hostname" every post-07:00 reboot (2026-07-21,
# both boots). Bounded DNS wait below is the real gate; fails loud after 60s.
After=network-online.target

[Service]
Type=oneshot
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do getent hosts moc.mf.internal >/dev/null 2>&1 && exit 0; sleep 2; done; echo "DNS for moc.mf.internal not up after 60s" >&2; exit 1'
ExecStart=/opt/meshforge/scripts/moc_drain_snapshot.sh moc
ExecStart=/opt/meshforge/scripts/moc_drain_snapshot.sh moc1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=moc-drain-snapshot
