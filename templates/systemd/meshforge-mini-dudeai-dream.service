[Unit]
Description=mini-dudeai nightly synthesis (B3 "dreams" + candidate memory-deltas)
After=meshforge-mini-dudeai.service

[Service]
Type=oneshot
# Same shadow-avoidance discipline as the daemon unit: pin cwd to the repo so
# `python3 -m mini_dudeai` never resolves a stray ~/mini_dudeai.py.
Environment=PYTHONPATH=/opt/meshforge/src
WorkingDirectory=/opt/meshforge
EnvironmentFile=-%h/.config/meshforge/mini_dudeai.env
# Reads ~/mini_dudeai_state.json + _history.jsonl; writes ~/mini_dudeai_dreams.md
# and appends ~/mini_dudeai_memory_deltas.jsonl. Observation-only — never writes
# canonical memory; the cloud session ratifies deltas.
ExecStart=/usr/bin/python3 -m mini_dudeai --preset meshforge_fleet --dream
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h
ProtectKernelTunables=true
StandardOutput=journal
StandardError=journal
