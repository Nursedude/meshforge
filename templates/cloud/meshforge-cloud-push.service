[Unit]
Description=MeshForge cloud :8808 snapshot push (oneshot, fired by timer)
Documentation=https://github.com/Nursedude/meshforge
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Run as the operator account that owns the SSH key for the cloud VPS
# and has read access to the meshtasticd HTTP API on localhost.
# Set this in the EnvironmentFile, not hardcoded.
User=
Group=
EnvironmentFile=-/etc/default/meshforge-cloud-push
ExecStart=/opt/meshforge/scripts/cloud/push_snapshot.sh
# Self-check that the cloud is serving the assets we expect after each
# push. Lightweight curl + grep; runs only when ExecStart succeeded.
# A failure here surfaces as systemctl-status-failed and a clear
# journalctl line, so silent regressions in static assets (e.g. the
# popup-wrap CSS) are caught at the cycle they happen, not "later."
ExecStartPost=/opt/meshforge/scripts/cloud/verify_cloud_assets.sh
# Don't fail the unit on transient errors — the timer fires again in 120s.
SuccessExitStatus=0 1
# Budget envelope: curl(90s) + space_weather(15s) + alerts(15s) + rsync. The
# timer cadence is 600s (see meshforge-cloud-push.timer — the 120s figure this
# comment once carried had drifted from it), so we cap BELOW that to avoid
# piling firings. 2026-09-05: with the ISP's transit at 5-10% loss / ~200 ms
# RTT to the VPS, a 4.2 MB snapshot legitimately takes 100-300 s and the old
# 120s ceiling killed every push for 80+ min while the VPS was healthy. Most
# cycles still finish in 20-60s; the ceiling exists for the lossy-WAN path.
TimeoutStartSec=540s
RuntimeMaxSec=540s

[Install]
WantedBy=multi-user.target
