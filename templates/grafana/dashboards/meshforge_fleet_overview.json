{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Phase E starter dashboard for the MeshForge map-domain audit arc. Shows per-box health, per-source collector outcomes, node inventory, and HTTP performance. Expand fleet by adding scrape targets to /etc/prometheus/prometheus.yml on moc1 — this dashboard auto-discovers them via the meshforge_map_* metrics' instance label.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "panels": [],
      "title": "Fleet health",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "1 = service is past warming and serving live traffic. 0 = warming or down. Driven by the F3 fix — the box can be `up` (Prometheus successfully scraped) yet `service_up=0` during cold-start warming.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"text": "warming/down", "color": "orange"}}, "type": "value"},
            {"options": {"1": {"text": "ready", "color": "green"}}, "type": "value"}
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.5},
              {"color": "green", "value": 1}
            ]
          }
        }
      },
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "Prometheus"},
          "expr": "meshforge_map_service_up",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Service ready (per box)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "Seconds spent in the warming state on each box. 0 = ready (no warming in progress). A non-zero plateau means the box is stuck in warming — investigate the per-box journal.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "pointSize": 5, "showPoints": "never"},
          "unit": "s"
        }
      },
      "gridPos": {"h": 6, "w": 16, "x": 8, "y": 1},
      "id": 2,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "Prometheus"},
          "expr": "(time() - meshforge_map_service_warming_started_seconds) * (meshforge_map_service_warming_started_seconds > 0)",
          "legendFormat": "{{instance}} warming for",
          "refId": "A"
        }
      ],
      "title": "Time in warming state",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 7},
      "id": 101,
      "panels": [],
      "title": "Collector outcomes",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "Nodes returned by the most recent collect() per source. Sources with persistent zero values (and reason_if_zero != 'ok') are surfaced in the next panel.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1}
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "Prometheus"},
          "expr": "meshforge_map_collector_nodes_yielded",
          "legendFormat": "{{instance}} / {{source}}",
          "refId": "A"
        }
      ],
      "title": "Nodes yielded per source (latest)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "Counter: total collect() cycles that ended with a non-ok reason. Spikes here indicate a source going unhealthy. The 'reason' label exposes the taxonomy from MapDataCollector._record_diagnostic.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 5, "lineWidth": 2}
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "Prometheus"},
          "expr": "rate(meshforge_map_collector_errors_total[5m])",
          "legendFormat": "{{instance}} {{source}} ({{reason}})",
          "refId": "A"
        }
      ],
      "title": "Collector errors per second (5m rate)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 16},
      "id": 102,
      "panels": [],
      "title": "Node inventory",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "Total nodes with positions (placed on the map). The visible mesh size from each box's perspective.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 20, "lineWidth": 2}
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17},
      "id": 5,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "Prometheus"},
          "expr": "meshforge_map_nodes_with_position",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Nodes with position",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "Nodes heard but not placeable, broken down by network. MeshCore without GPS is the typical contributor. High counts here + zero in 'with position' for the same network = operator should add coordinates via meshcore_positions in map_settings.json (Issue #43).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "bars", "fillOpacity": 80, "stacking": {"mode": "normal"}}
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 17},
      "id": 6,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "Prometheus"},
          "expr": "meshforge_map_nodes_without_position",
          "legendFormat": "{{instance}} / {{network}}",
          "refId": "A"
        }
      ],
      "title": "Nodes without position (by network)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 25},
      "id": 103,
      "panels": [],
      "title": "HTTP performance",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "Request rate per endpoint, in requests per second over a 1-minute window. /api/nodes/geojson is the heaviest path; /api/status and /healthz are the cheap ones Prometheus + the TUI hit frequently.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2},
          "unit": "reqps"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26},
      "id": 7,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "Prometheus"},
          "expr": "sum by (endpoint, instance) (rate(meshforge_map_http_requests_total[1m]))",
          "legendFormat": "{{instance}} {{endpoint}}",
          "refId": "A"
        }
      ],
      "title": "Request rate by endpoint (1m)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "description": "p95 latency per endpoint. /api/nodes/geojson on a Pi 4B can be ~1s when MeshCore is included; /api/status and /healthz should stay under 10ms. Alert if p95 climbs above the histogram's 1s bucket sustained.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 5, "lineWidth": 2},
          "unit": "s"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26},
      "id": 8,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "Prometheus"},
          "expr": "histogram_quantile(0.95, sum by (endpoint, instance, le) (rate(meshforge_map_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{instance}} {{endpoint}} p95",
          "refId": "A"
        }
      ],
      "title": "p95 request latency (5m)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["meshforge", "map-arc"],
  "templating": {
    "list": [
      {
        "current": {"selected": false, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "definition": "label_values(meshforge_map_service_up, instance)",
        "hide": 0,
        "includeAll": true,
        "label": "Box",
        "multi": true,
        "name": "instance",
        "options": [],
        "query": {"query": "label_values(meshforge_map_service_up, instance)", "refId": "StandardVariableQuery"},
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "MeshForge Fleet Overview",
  "uid": "meshforge-fleet-overview",
  "version": 1,
  "weekStart": ""
}
