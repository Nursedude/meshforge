[Unit]
Description=MeshForge Map Server - NOC Web Interface
Documentation=https://github.com/Nursedude/meshforge
After=network.target meshtasticd.service mosquitto.service
Wants=meshtasticd.service mosquitto.service

# Stop crash-looping after 3 failures in 60 seconds
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# __MESHFORGE_USER__ is substituted at install time by install_noc.sh
# or migrate_map_service_to_user.sh. Falls back to operator's login name
# (never 'root'). Fixes config/DB drift between TUI (sudo, $SUDO_USER) and
# the service (was running as root → /root/.config/, /root/.local/share/).
User=__MESHFORGE_USER__
WorkingDirectory=/opt/meshforge/src
RuntimeDirectory=meshforge

# Use venv if available, fall back to system Python
ExecStart=/bin/bash -c '\
    if [ -x /opt/meshforge/venv/bin/python ]; then \
        exec /opt/meshforge/venv/bin/python -m utils.map_data_service --daemon --host 0.0.0.0 --port 5000; \
    else \
        exec python3 -m utils.map_data_service --daemon --host 0.0.0.0 --port 5000; \
    fi'

# Graceful shutdown
ExecStop=/bin/kill -TERM $MAINPID

# After the service exits, checkpoint node_history.db so the WAL doesn't
# accumulate across long uptimes. SQLite checkpoints opportunistically
# during runtime, so a 4-day uptime can leave a 400-500 MB WAL pending.
# Without this, the next cold start spends 1-10 min in WAL replay
# before /api/* responds (returning 503 service_warming the whole time).
# Doing the checkpoint at stop time pays the cost when nobody's waiting.
# `|| true` ensures a SQLite failure doesn't block the stop sequence —
# the next start will replay the WAL the slow way as a fallback.
# See `project_meshforge_map_cold_start_wal` in operator memory.
ExecStopPost=/bin/bash -c 'sqlite3 /home/__MESHFORGE_USER__/.local/share/meshforge/node_history.db "PRAGMA wal_checkpoint(TRUNCATE);" 2>&1 || true'
# Bumped from 10s → 60s to give the checkpoint room on Pi-class SD with
# a large WAL. Real-world cold-start (no fix) was 5-10 min; doing it
# here at stop time is much faster because no concurrent reads compete.
TimeoutStopSec=60

# Restart policy
Restart=on-failure
RestartSec=5

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=meshforge-map

# Security hardening (relaxed for access to user dirs and radio)
ProtectSystem=false
PrivateTmp=false
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
