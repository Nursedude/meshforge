[Unit]
Description=MeshForge Map Server - NOC Web Interface
Documentation=https://github.com/Nursedude/meshforge
After=network.target meshtasticd.service mosquitto.service
Wants=meshtasticd.service mosquitto.service

# Stop crash-looping after 3 failures in 60 seconds
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# __MESHFORGE_USER__ is substituted at install time by install_noc.sh
# or migrate_map_service_to_user.sh. Falls back to operator's login name
# (never 'root'). Fixes config/DB drift between TUI (sudo, $SUDO_USER) and
# the service (was running as root → /root/.config/, /root/.local/share/).
User=__MESHFORGE_USER__
WorkingDirectory=/opt/meshforge/src
RuntimeDirectory=meshforge

# Use venv if available, fall back to system Python
# --cors-origins set so the MA dashboard at http://<lan-host>:5000
# can fetch this box's /fleet/logs etc. cross-origin. Origins are
# *prefix* matched (see MapRequestHandler._send_cors_header in
# map_http_handler.py). The box's own IPv4 /24s are derived at start
# time from `hostname -I` — covers every host on each local subnet
# without baking an operator-specific prefix into repo source (MF014).
#
# DOUBLE ESCAPE on the /24 derivation (drill-proven 2026-07-26): systemd
# expands ${...} and % specifiers BEFORE bash sees the line — a bare
# ${ip%.*} is an "Invalid environment variable name evaluates to an empty
# string: ip%.*" and the derived prefix collapses to "http://.". So the
# unit carries $${ip%%.*}: systemd unescapes $$ -> $ and %% -> % (a bare %
# would be read as a systemd specifier, systemd.unit(5) "Specifiers"),
# handing bash exactly ${ip%.*} — strip-ONE-trailing-octet, the intent
# (%%.* in BASH would strip all octets; the doubling belongs to systemd).
ExecStart=/bin/bash -c '\
    CORS="http://localhost,http://127.0.0.1"; \
    for ip in $(hostname -I 2>/dev/null); do \
        case "$ip" in *.*.*.*) CORS="$CORS,http://$${ip%%.*}.";; esac; \
    done; \
    if [ -x /opt/meshforge/venv/bin/python ]; then \
        exec /opt/meshforge/venv/bin/python -m utils.map_data_service --daemon --host 0.0.0.0 --port 5000 --cors-origins "$CORS"; \
    else \
        exec python3 -m utils.map_data_service --daemon --host 0.0.0.0 --port 5000 --cors-origins "$CORS"; \
    fi'

# Graceful shutdown
ExecStop=/bin/kill -TERM $MAINPID

# After the service exits, checkpoint node_history.db so the WAL doesn't
# accumulate across long uptimes. SQLite checkpoints opportunistically
# during runtime, so a 4-day uptime can leave a 400-500 MB WAL pending.
# Without this, the next cold start spends 1-10 min in WAL replay
# before /api/* responds (returning 503 service_warming the whole time).
# Doing the checkpoint at stop time pays the cost when nobody's waiting.
# `|| true` ensures a SQLite failure doesn't block the stop sequence —
# the next start will replay the WAL the slow way as a fallback.
# See `project_meshforge_map_cold_start_wal` in operator memory.
ExecStopPost=/bin/bash -c 'sqlite3 /home/__MESHFORGE_USER__/.local/share/meshforge/node_history.db "PRAGMA wal_checkpoint(TRUNCATE);" 2>&1 || true'
# Bumped 10s → 60s → 300s. The 60s window was witnessed too short on
# moc1's 4.7 GB node_history.db on 2026-05-13: the wal_checkpoint took
# longer than 60s, systemd killed the unit mid-checkpoint, leaving the
# WAL in an inconsistent state. The next start then had to do a full
# WAL recovery (state D, `do_get_write_access` in ext4 JBD2) before
# even binding :5000 — a 15+ min cascade. 300s gives the checkpoint
# room on fat DBs while shutdowns on normal-sized DBs still finish in
# seconds. Cleaner long-term: move checkpoint into the Python daemon's
# shutdown hook so systemd's TimeoutStopSec covers the whole sequence
# rather than only ExecStopPost; deferred until needed.
TimeoutStopSec=300

# Restart policy
Restart=on-failure
RestartSec=5

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=meshforge-map

# Security hardening (relaxed for access to user dirs and radio)
ProtectSystem=false
PrivateTmp=false
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
