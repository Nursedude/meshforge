[Unit]
Description=MeshForge Gateway Bridge (Meshtastic <-> RNS/LXMF)
After=network-online.target rnsd.service
Wants=network-online.target rnsd.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=/opt/meshforge
Environment=PYTHONUNBUFFERED=1
Environment=HOME=@HOME@
ExecStart=/usr/bin/python3 /opt/meshforge/src/gateway/bridge_cli.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# /etc/reticulum/storage is REQUIRED: as a shared-instance RNS client the gateway
# assembles inbound RNS Resources (multi-chunk LXMF — e.g. a wx/leaderboard bot
# reply) by writing them under <configdir>/storage/resources. Without it,
# ProtectSystem=strict makes /etc read-only and assembly fails [Errno 30] EROFS,
# silently dropping every resource-sized reply while the gateway stays "active /
# RNS: connected" (2026-06-20; #60 sandbox-drift class — the wx-dark incident).
ReadWritePaths=@HOME@/.config/meshforge @HOME@/.cache/meshforge @HOME@/.local/share/meshforge /etc/reticulum/storage
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
