#!/bin/bash
# MeshForge Pre-Commit Hook
#
# Runs the linter on staged files and regression guard tests before each commit.
# This prevents known anti-patterns from being reintroduced (Issue #29).
#
# Setup: git config core.hooksPath .githooks
# Bypass: git commit --no-verify (use sparingly)

set -e

# Run MeshForge linter on staged files (errors only)
echo "Running MeshForge linter..."
if ! python3 scripts/lint.py --staged --severity error 2>/dev/null; then
    echo ""
    echo "Lint errors found. Fix before committing."
    echo "Run: python3 scripts/lint.py --staged"
    exit 1
fi

# Run regression guards (fast — file scanning only, no service deps)
echo "Running regression guards..."
if ! python3 -m pytest tests/test_regression_guards.py -x -q 2>/dev/null; then
    echo ""
    echo "Regression guard failed. A known anti-pattern was introduced."
    echo "Run: python3 -m pytest tests/test_regression_guards.py -v"
    exit 1
fi

# Parity-mirror execution gate (2026-07-02): byte-identical parity files must
# also EXECUTE here — a mirror commit that keeps canonical_message.py in sync
# but breaks its collaborators (MeshAnchor's STEP-3 BridgedMessage.content_id
# gap: TypeError on every Canonical→Bridged for 2 days) is caught at commit
# time. parity_check proves BYTES, this proves the repo can RUN them. <1s.
if git diff --cached --name-only | grep -qE '^src/gateway/(canonical_message|rns_bridge)\.py$'; then
    echo "Shared-contract surface changed — running canonical execution tests..."
    if ! python3 -m pytest tests/test_canonical_message.py -x -q 2>/dev/null; then
        echo ""
        echo "canonical_message execution tests failed — the parity file cannot"
        echo "run against this repo's collaborators (BridgedMessage et al.)."
        echo "Run: python3 -m pytest tests/test_canonical_message.py -v"
        exit 1
    fi
fi

# Capability-index drift gate (2026-07-04): a new/changed TUI handler shifts
# the live registry, but the COMMITTED capability index
# (.claude/skills/meshforge/capability_index.md, gen_capability_index.py output)
# does not regenerate itself — so it drifts, passes local dev, and only CI's
# test_capability_index catches it (cost a RED cycle on the offline_oracle
# handler). Run the drift test at commit time when a handler changes. <1s.
if git diff --cached --name-only | grep -qE '^src/launcher_tui/handlers/'; then
    echo "TUI handler changed — checking capability-index drift..."
    if ! python3 -m pytest tests/test_capability_index.py -x -q 2>/dev/null; then
        echo ""
        echo "Capability index is stale for the current handler registry."
        echo "Regenerate: python3 scripts/gen_capability_index.py"
        echo "then stage .claude/skills/meshforge/capability_index.md"
        exit 1
    fi
fi

# Collection-only sweep: catches module-level import/syntax errors across the
# full suite without running test bodies. Fast (~2-3s) and flags the class of
# regression where a test module fails to import in CI but loads in dev.
echo "Collecting test modules..."
if ! python3 -m pytest --collect-only -q tests/ >/dev/null 2>&1; then
    echo ""
    echo "Test collection failed — a test module won't import."
    echo "Run: python3 -m pytest --collect-only tests/"
    exit 1
fi

# Validate Claude Code permission grammar in .claude/settings.json
# Catches silently-skipped rules (CVE-2026-21852 class of issue).
if [ -f .claude/settings.json ]; then
    echo "Validating .claude/settings.json permission grammar..."
    if ! python3 scripts/validate_claude_settings.py .claude/settings.json; then
        echo ""
        echo "Permission grammar invalid. Malformed rules would be silently skipped."
        exit 1
    fi
fi

echo "Pre-commit checks passed."
