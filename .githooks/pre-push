#!/bin/bash
# MeshForge pre-push hook
#
# Runs scripts/healthcheck.sh before pushing to keep CI from going red.
# Today (2026-05-03) we shipped two pushes that compounded a CI red
# baseline before the surface failure was even fixed; pre-push closes
# that loop. Bypass with `git push --no-verify` if you really need to.
#
# Setup: git config core.hooksPath .githooks (already on per CLAUDE.md)

set -u

# Only run on push to origin; skip for pushes to local sandboxes / forks
# (those are usually personal experiments). Adjust if your workflow
# differs.
remote="$1"
if [ "$remote" != "origin" ] && [ "$remote" != "meshforge" ]; then
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"

if [ ! -x "$REPO_ROOT/scripts/healthcheck.sh" ]; then
    echo "scripts/healthcheck.sh not found or not executable — skipping pre-push check" >&2
    exit 0
fi

# Default: lint only — fast (~2s) and catches MF-rule violations
# (including MF016 which would have blocked the 2026-05-03 incident).
# This box runs as a real fleet member, so the local test suite has
# environmental failures (real meshtasticd/RNS/cached DB) that would
# always block a push without telling us anything CI-relevant. Lint
# is environment-independent and high-value.
#
# Opt-in escalation:
#   MESHFORGE_PREPUSH_FULL=1  → run full test suite locally too
#   MESHFORGE_PREPUSH_CLEAN=1 → run in clean CI-parity venv (slowest, most accurate)
if [ "${MESHFORGE_PREPUSH_CLEAN:-0}" = "1" ]; then
    "$REPO_ROOT/scripts/healthcheck.sh" --clean-venv
elif [ "${MESHFORGE_PREPUSH_FULL:-0}" = "1" ]; then
    "$REPO_ROOT/scripts/healthcheck.sh"
else
    "$REPO_ROOT/scripts/healthcheck.sh" --lint-only
fi
rc=$?

if [ "$rc" -ne 0 ]; then
    echo ""
    echo "Pre-push healthcheck failed. Fix issues or override with:"
    echo "  git push --no-verify"
    exit 1
fi

# Regression guards — the architectural WIRING invariants (seed coverage, RNS
# chokepoint, TCP/service contracts, operator-value leaks). Fast (~4s) and
# env-independent. pre-commit runs these too; re-running at push is the backstop
# for a --no-verify commit, or a commit made while the hook was inactive (the
# core.hooksPath gap found 2026-06-15). This is the "can't push mis-wired work"
# gate.
echo "Pre-push: regression guards (wiring invariants)..."
if ! python3 -m pytest "$REPO_ROOT/tests/test_regression_guards.py" -x -q >/dev/null 2>&1; then
    echo ""
    echo "Regression guard FAILED — a wiring/anti-pattern regression. Run:"
    echo "  python3 -m pytest tests/test_regression_guards.py -v"
    echo "Override (sparingly): git push --no-verify"
    exit 1
fi

# Upshift-witness — compiles model_advisor's "queue, don't fake the frontier
# pass" behavior into a deterministic gate (scripts/review_provenance_check.py):
# leg 1 (review-claim commits must leave a provenance row) and leg 2 (a
# non-frontier session can't stamp a frontier-tier row) block; leg 3 is an
# advisory nudge. Fails OPEN (warn, exit 0) on anything unobservable. Fast,
# env-independent (git + the local ledger). The script prints its own remediation
# incl. the --no-verify override, so the hook just relays its exit code.
if [ -f "$REPO_ROOT/scripts/review_provenance_check.py" ]; then
    echo "Pre-push: upshift-witness (review provenance)..."
    if ! python3 "$REPO_ROOT/scripts/review_provenance_check.py"; then
        echo ""
        echo "Upshift-witness gate FAILED (see above)."
        exit 1
    fi
fi

# Parent-CI advisory — don't silently STACK onto an already-red origin/main
# (the 2026-05-03 cascade: two pushes compounded a red baseline). Best-effort
# and WARN-only: never blocks (gh/network may be down, or you may be pushing
# the very fix). Honest about uncertainty — silent when it can't tell.
if command -v gh >/dev/null 2>&1; then
    base=$(git rev-parse origin/main 2>/dev/null)
    if [ -n "${base:-}" ] && gh run list --branch main --limit 20 \
         --json headSha,conclusion,status >/tmp/.prepush_ci.json 2>/dev/null; then
        cc=$(base="$base" python3 - <<'PY' 2>/dev/null
import json, os
sha = os.environ["base"]
try:
    for r in json.load(open("/tmp/.prepush_ci.json")):
        if r.get("headSha") == sha:
            print(r.get("conclusion") or r.get("status") or "")
            break
except Exception:
    pass
PY
)
        if [ "$cc" = "failure" ]; then
            echo "WARN: origin/main tip ${base:0:7} CI=FAILURE — you're pushing onto RED."
            echo "      (advisory only; consider whether this push fixes it)"
        fi
    fi
fi

echo "Pre-push checks passed."
exit 0
