#!/bin/bash
# MeshForge pre-push hook
#
# Runs scripts/healthcheck.sh before pushing to keep CI from going red.
# Today (2026-05-03) we shipped two pushes that compounded a CI red
# baseline before the surface failure was even fixed; pre-push closes
# that loop. Bypass with `git push --no-verify` if you really need to.
#
# Setup: git config core.hooksPath .githooks (already on per CLAUDE.md)

set -u

# Only run on push to origin; skip for pushes to local sandboxes / forks
# (those are usually personal experiments). Adjust if your workflow
# differs.
remote="$1"
if [ "$remote" != "origin" ] && [ "$remote" != "meshforge" ]; then
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
# Shared pytest wrapper (run + classify honestly); fails CLOSED.
. "$REPO_ROOT/scripts/lib/pytest_checked.sh"

if [ ! -x "$REPO_ROOT/scripts/healthcheck.sh" ]; then
    echo "scripts/healthcheck.sh not found or not executable — skipping pre-push check" >&2
    exit 0
fi

# Default: lint only — fast (~2s) and catches MF-rule violations
# (including MF016 which would have blocked the 2026-05-03 incident).
# This box runs as a real fleet member, so the local test suite has
# environmental failures (real meshtasticd/RNS/cached DB) that would
# always block a push without telling us anything CI-relevant. Lint
# is environment-independent and high-value.
#
# Opt-in escalation:
#   MESHFORGE_PREPUSH_FULL=1  → run full test suite locally too
#   MESHFORGE_PREPUSH_CLEAN=1 → run in clean CI-parity venv (slowest, most accurate)
if [ "${MESHFORGE_PREPUSH_CLEAN:-0}" = "1" ]; then
    "$REPO_ROOT/scripts/healthcheck.sh" --clean-venv
elif [ "${MESHFORGE_PREPUSH_FULL:-0}" = "1" ]; then
    "$REPO_ROOT/scripts/healthcheck.sh"
else
    "$REPO_ROOT/scripts/healthcheck.sh" --lint-only
fi
rc=$?

if [ "$rc" -ne 0 ]; then
    echo ""
    echo "Pre-push healthcheck failed. Fix issues or override with:"
    echo "  git push --no-verify"
    exit 1
fi

# Regression guards — the architectural WIRING invariants (seed coverage, RNS
# chokepoint, TCP/service contracts, operator-value leaks). Fast (~4s) and
# env-independent. pre-commit runs these too; re-running at push is the backstop
# for a --no-verify commit, or a commit made while the hook was inactive (the
# core.hooksPath gap found 2026-06-15). This is the "can't push mis-wired work"
# gate.
echo "Pre-push: regression guards (wiring invariants)..."
if ! mf_pytest_checked "$REPO_ROOT/tests/test_regression_guards.py" -x -q; then
    echo ""
    cat "$MF_PYTEST_LOG"; rm -f "$MF_PYTEST_LOG"
    echo ""
    echo "Regression guard $MF_PYTEST_VERDICT — a wiring/anti-pattern regression,"
    echo "or a run we could not classify. Either way this is not a pass."
    echo "  $MF_PYTEST_WHY"
    echo "Run: python3 -m pytest tests/test_regression_guards.py -v"
    echo "Override (sparingly): git push --no-verify"
    exit 1
fi
rm -f "$MF_PYTEST_LOG"

# Upshift-witness — compiles model_advisor's "queue, don't fake the frontier
# pass" behavior into a deterministic gate (scripts/review_provenance_check.py):
# leg 1 (review-claim commits must leave a provenance row) and leg 2 (a
# non-frontier session can't stamp a frontier-tier row) block; leg 3 is an
# advisory nudge. Fails OPEN (warn, exit 0) on anything unobservable. Fast,
# env-independent (git + the local ledger). The script prints its own remediation
# incl. the --no-verify override, so the hook just relays its exit code.
if [ -f "$REPO_ROOT/scripts/review_provenance_check.py" ]; then
    echo "Pre-push: upshift-witness (review provenance)..."
    if ! python3 "$REPO_ROOT/scripts/review_provenance_check.py"; then
        echo ""
        echo "Upshift-witness gate FAILED (see above)."
        exit 1
    fi
fi

# Parent-CI advisory — don't silently STACK onto an already-red origin/main
# (the 2026-05-03 cascade: two pushes compounded a red baseline). Best-effort
# and WARN-only: never blocks (gh/network may be down, or you may be pushing
# the very fix). Honest about uncertainty — silent when it can't tell.
if command -v gh >/dev/null 2>&1; then
    base=$(git rev-parse origin/main 2>/dev/null)
    if [ -n "${base:-}" ] && gh run list --branch main --limit 20 \
         --json headSha,conclusion,status >/tmp/.prepush_ci.json 2>/dev/null; then
        cc=$(base="$base" python3 - <<'PY' 2>/dev/null
import json, os
sha = os.environ["base"]
try:
    for r in json.load(open("/tmp/.prepush_ci.json")):
        if r.get("headSha") == sha:
            print(r.get("conclusion") or r.get("status") or "")
            break
except Exception:
    pass
PY
)
        if [ "$cc" = "failure" ]; then
            echo "WARN: origin/main tip ${base:0:7} CI=FAILURE — you're pushing onto RED."
            echo "      (advisory only; consider whether this push fixes it)"
        fi
    fi
fi

# Byte-lock parity — the twin contract (2026-09-09). 151ms, env-independent.
# WHY IT IS HERE: on 2026-09-09 I edited the byte-locked src/utils/fleet_truth.py
# and pushed FOUR times without porting it. parity_check.py existed, took a
# seventh of a second, and was not wired into any hook — the drift surfaced
# hours later in honest_status. Tri-state on purpose: 1 = real drift and BLOCKS,
# 2 = the twin repo is not on this box so parity is UNOBSERVABLE and must not
# read as either (unobservable != in sync != drift, honest_failure_modes #2).
PARITY_RAN=no
if [ -f "$REPO_ROOT/scripts/parity_check.py" ]; then
    echo "Pre-push: byte-lock parity (twin contract)..."
    python3 "$REPO_ROOT/scripts/parity_check.py" >/tmp/.prepush_parity.out 2>&1
    prc=$?
    if [ "$prc" -eq 1 ]; then
        cat /tmp/.prepush_parity.out
        echo ""
        echo "Byte-locked file(s) DRIFTED from the twin. MeshForge is the lead repo:"
        echo "  port the flagged file(s), then re-run: python3 scripts/parity_check.py"
        echo "Override (sparingly): git push --no-verify"
        rm -f /tmp/.prepush_parity.out
        exit 1
    elif [ "$prc" -eq 0 ]; then
        PARITY_RAN=yes
    else
        echo "  WARN: parity UNOBSERVABLE (exit $prc) — twin repo absent on this box."
        echo "        Not a pass and not a failure; port checks are on you."
    fi
    rm -f /tmp/.prepush_parity.out
fi

# Doc stat sentinels — 67ms. Same story: adding ONE test file on 2026-09-09
# bumped a filesystem-derived count and reddened CI three pushes running, while
# the checker sat unwired. Note --check: the bare invocation exits 2 whether
# clean or drifted, so its raw exit code is NOT a gate signal.
SENTINELS_RAN=no
if [ -f "$REPO_ROOT/scripts/readme_stats.py" ]; then
    echo "Pre-push: doc stat sentinels..."
    if ! python3 "$REPO_ROOT/scripts/readme_stats.py" --check >/tmp/.prepush_stats.out 2>&1; then
        cat /tmp/.prepush_stats.out
        echo ""
        echo "Doc stat sentinel(s) drifted from the tree. Fix with:"
        echo "  python3 scripts/readme_stats.py --update   # then commit the docs change"
        echo "Override (sparingly): git push --no-verify"
        rm -f /tmp/.prepush_stats.out
        exit 1
    fi
    SENTINELS_RAN=yes
    rm -f /tmp/.prepush_stats.out
fi

# ── THE SCOPE STATEMENT ──────────────────────────────────────────────────────
# This used to read "Pre-push checks passed." and nothing else. That single line
# is what let me push red CI four times on 2026-09-09: the hook measured a
# SUBSET honestly, and I read its pass as clearance. It never claimed that — I
# borrowed the broader claim, which is the same thing service_inactive's cell
# was doing to /fleet and the 80KB gate was doing to harness_audit. So the gate
# now states what it did NOT check, exactly as those cells now name their
# quantity. A gate that reports its own scope cannot be misread as coverage.
if [ "$PARITY_RAN" = yes ]; then p_state="checked"; else p_state="UNOBSERVABLE"; fi
if [ "$SENTINELS_RAN" = yes ]; then s_state="checked"; else s_state="skipped"; fi
echo ""
echo "Pre-push checks passed."
echo "  SCOPE: lint, regression guards, upshift-witness,"
echo "         byte-lock parity ($p_state), doc sentinels ($s_state)."
echo "  NOT RUN: the full test suite (~13 min), and CI."
echo "           This is a SUBSET. It does not license 'safe to push'."
echo "    full suite before pushing:  MESHFORGE_PREPUSH_FULL=1 git push"
echo "    after pushing (of record):  bash scripts/honest_status.sh"
exit 0
