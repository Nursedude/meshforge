#!/bin/bash
# MeshForge Post-Commit Hook
#
# Closes the deploy-restart gap for the fleet-truth signal-class enum.
#
# `meshforge-map` (the process serving the /fleet coverage view) imports
# `utils.watchdog_probe_core.SIGNAL_CLASSES` ONCE at startup (fleet_truth.py
# comment near `unknown_to_server`). After the enum grows, a still-running map
# process holds the stale set and lists newly-added classes reported by peers as
# `unknown_to_server` -> coverage renders PARTIAL until the process is restarted.
#
# Pulling boxes already restart meshforge-map via fleet_sync (Issue #53). The
# uncovered path is the MANAGER/dev box that COMMITS the enum change locally
# without a pull. This hook restarts the local map exactly when that file lands
# in a commit, so the running coverage view re-imports the current enum.
#
# git IGNORES a post-commit hook's exit status, so this is best-effort by
# construction: it never blocks or fails a commit. It no-ops where the map
# isn't running (guarded), so it is harmless on non-map boxes even though the
# hook ships in the repo for every box.
#
# Setup: git config core.hooksPath .githooks

# The enum SSOT whose change requires the map to re-import it.
ENUM_FILE="src/utils/watchdog_probe_core.py"
MAP_UNIT="meshforge-map.service"

# Did this commit touch the enum SSOT? (files in the just-made commit)
if ! git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null \
        | grep -qxF "$ENUM_FILE"; then
    exit 0
fi

# Only act where the map is actually serving on this box (read-only query, no
# sudo). A no-op everywhere else keeps the committed hook harmless fleet-wide.
if ! systemctl is-active --quiet "$MAP_UNIT" 2>/dev/null; then
    exit 0
fi

echo "post-commit: $ENUM_FILE changed — refreshing $MAP_UNIT signal-class enum."

# --no-block: enqueue the restart and return immediately. The map's ExecStartPre
# waits on rnstatus (up to 90s); without --no-block this hook would hang the
# commit for that long. -n: never prompt for a password — if passwordless sudo
# is unavailable, print the manual step instead of blocking.
if sudo -n systemctl --no-block try-restart "$MAP_UNIT" 2>/dev/null; then
    echo "post-commit: $MAP_UNIT restart enqueued (async); coverage will re-derive."
else
    echo "post-commit: could not auto-restart $MAP_UNIT (no passwordless sudo)."
    echo "post-commit: restart it manually so /fleet coverage picks up the new enum:"
    echo "    sudo systemctl restart $MAP_UNIT"
fi

exit 0
